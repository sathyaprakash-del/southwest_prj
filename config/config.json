{
  "_comment": "Southwest MDM staging config. Stages run Jeppesen -> BTS -> Innovata (independent) -> Olson (csv).",
  "run": {
    "skip_lines": 4,
    "data_directory": "",
    "output_directory": "",
    "batch_id": null,
    "batch_id_format": "",
    "run_indicator": "",
    "domain": "",
    "status_file": ""
  },
  "directories": {
    "output": "output",
    "stage": "output/stage",
    "history": "output/history",
    "history_prefix": "SWA_JEPPESEN_",
    "logs": "logs"
  },
  "logs": {
    "jeppesen": "logs/stage_jeppesen.log",
    "bts": "logs/stage_bts.log",
    "innovata": "logs/stage_innovata.log",
    "olson": "logs/stage_olson.log",
    "olson_pip": "logs/stage_olson_pip.log",
    "mdm": "logs/SWA_MDM.log"
  },
  "sources": {
    "jeppesen": {
      "file_path": "input/SWA_JEPPESEN (1).dat",
      "encoding": "utf-8",
      "required": true
    },
    "bts": {
      "file_path": "input/SWA_BTS.csv",
      "encoding": "utf-8",
      "delimiter": ",",
      "required": true
    },
    "innovata_stn": {
      "file_path": "input/SWA_INV_STN.dat",
      "encoding": "latin-1",
      "delimiter": "\\t",
      "required": false,
      "note": "Innovata independent load, no Jeppesen join"
    },
    "innovata_tz": {
      "file_path": "input/SWA_INV_TZ.dat",
      "encoding": "latin-1",
      "delimiter": "\\t",
      "required": false,
      "note": "Innovata independent load, no Jeppesen join"
    },
    "olson": {
      "file_path": "input/loc_olson_id_stg_export.csv",
      "encoding": "utf-8-sig",
      "delimiter": ",",
      "required": true,
      "note": "Google Olson export, direct source for stage_olson csv mode"
    },
    "db_schema": {
      "file_path": "",
      "encoding": "",
      "required": false,
      "note": ""
    }
  },
  "schema_check": {
    "enabled": false,
    "fail_on_mismatch": false
  },
  "joins": {
    "airport_code": {
      "jeppesen_column": "IATA_ARPT_CDE",
      "bts_field": "AIRPORT",
      "innovata_station_field": "STACODE",
      "note": "3-letter IATA code shared by Jeppesen and BTS. Innovata independent, no join filter."
    },
    "station_to_timezone": {
      "station_fields": ["CNTRYCODE", "TZCODE"],
      "timezone_fields": ["CNTRYCODE", "TZCODE"],
      "note": "Innovata independent, 1 station : N periods"
    },
    "olson": {
      "jeppesen_column": "ICAO_ARPT_CDE",
      "olson_field": "ICAO_CDE",
      "note": "4-letter ICAO for audit only (in_jeppesen / not_in_jeppesen), no filter."
    }
  },
  "jeppesen": {
    "trim_values": true,
    "sql_escape_apostrophes": false,
    "failure_threshold_percent": 1,
    "errors_file": "",
    "record_types": {
      "airport": {
        "description": "Airport line A/1 -> LOC_AIRPORT_STG",
        "output_file": "LOC_AIRPORT_STG.csv",
        "table": "",
