  "innovata": {
    "_comment": "Mapping follows KT document v16 section 2.4 (station tokens 1,4,5,6,9 and all 11 time zone tokens). GMTVAR is copied as is into TM_ZN_UTC_OFST_MIN_NUM, as the production parser does; use source tz_offset_min instead to convert it to minutes.",
    "table": "LOC_TMZN_STG",
    "output_file": "stage/LOC_TMZN_STG.csv",
    "errors_file": "innovata_errors.csv",
    "station_text_check_fields": [
      "STANAME",
      "CITYNAME"
    ],
    "special_char_pattern": "[^\\x20-\\x7E]",
    "tz_period_mode": "all",
    "as_of_date": null,
    "columns": [
      {
        "name": "BATCHID",
        "source": "batch_id"
      },
      {
        "name": "IATA_ARPT_CDE",
