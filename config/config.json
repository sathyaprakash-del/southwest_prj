  "bts": {
    "table": "",
    "report_rejects": false,
    "rejects_file": "",
    "reject_report_columns": [],
    "errors_file": "",
    "staging_columns": [],
    "location_check_km": null,
    "skip_on_location_mismatch": false,
    "columns": [
      "AIRPORT",
      "LAT_DEGREES",
      "LAT_HEMISPHERE",
      "LAT_MINUTES",
      "LAT_SECONDS",
      "LATITUDE",
      "LON_DEGREES",
      "LON_HEMISPHERE",
      "LON_MINUTES",
      "LON_SECONDS",
      "LONGITUDE"
    ],
    "column_prefix": "bts_",
    "accept_rules": [
      {
        "field": "AIRPORT_IS_LATEST",
        "equals": "1"
      },
      {
        "field": "AIRPORT_THRU_DATE",
        "is_empty": true
      }
    ],
    "output_file": "LOC_AIRPORT_STG.csv"
